# TaskFlow Security Configuration
# Prevent access to sensitive files and directories

# Prevent directory listing
Options -Indexes

# Enable mod_rewrite for clean URLs
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /taskflow/

    # Clean URLs for core pages
    RewriteRule ^auth$ login.php [L,QSA]
    RewriteRule ^dashboard$ index.php?page=dashboard [L,QSA]
    RewriteRule ^calendar$ index.php?page=calendar [L,QSA]
    RewriteRule ^notes$ index.php?page=notes [L,QSA]
    RewriteRule ^dokumen$ index.php?page=documents [L,QSA]
    RewriteRule ^kanban$ index.php?page=projects [L,QSA]
    RewriteRule ^activities$ index.php?page=activities [L,QSA]
    RewriteRule ^settings$ index.php?page=settings [L,QSA]
    RewriteRule ^profile$ index.php?page=profile [L,QSA]
    RewriteRule ^reset-password$ index.php?page=reset-password [L,QSA]
    RewriteRule ^logout$ index.php?logout=1 [L,QSA]

    # "Encrypted" style link example
    RewriteRule ^secure-login-([a-f0-9]{8})$ login.php?token=$1 [L,QSA]

    # Fallback to index.php if not a file or directory
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?path=$1 [L,QSA]
</IfModule>

# Deny access to sensitive file types
<FilesMatch "\.(sql|zip|tar|log|env|yml|yaml)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Deny access to config files
<Files config.php>
    Order Deny,Allow
    Deny from all
</Files>

# Deny access to .htaccess
<Files .htaccess>
    Order Deny,Allow
    Deny from all
</Files>

# Deny PHP execution in uploads directories
<FilesMatch "^/(uploads|logs)/.*\.php$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
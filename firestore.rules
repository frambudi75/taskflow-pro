rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "frambudihabib@gmail.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "administrator"
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validation functions
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.email is string &&
             data.role in ['administrator', 'user'];
    }

    function isValidTodo(data) {
      return data.keys().hasAll(['title', 'date', 'completed', 'userId']) &&
             data.userId == request.auth.uid;
    }

    function isValidNote(data) {
      return data.keys().hasAll(['title', 'content', 'updatedAt', 'userId']) &&
             data.userId == request.auth.uid;
    }

    function isValidDocument(data) {
      return data.keys().hasAll(['name', 'type', 'uploadDate', 'userId']) &&
             data.userId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin(); // Only admins can create users
      allow update: if isAdmin() || (isOwner(uid) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /todos/{todoId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && isValidTodo(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isValidTodo(request.resource.data);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /notes/{noteId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && isValidNote(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isValidNote(request.resource.data);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /documents/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && isValidDocument(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isValidDocument(request.resource.data);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
